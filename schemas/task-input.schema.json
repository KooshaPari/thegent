{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thegent.dev/schemas/task-input.schema.json",
  "title": "Task Input Schema",
  "description": "Schema for task input files (YAML frontmatter + Markdown)",
  "type": "object",
  "required": ["id", "title", "subagent_type", "priority"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 3,
      "maxLength": 100,
      "description": "Unique task identifier (lowercase alphanumeric with hyphens)",
      "examples": ["docgen-sticky-nav", "research-tui-compositor"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Brief, descriptive task title",
      "examples": ["Implement sticky sidebar", "Research TUI compositor frameworks"]
    },
    "subagent_type": {
      "type": "string",
      "enum": ["worker", "flash", "researcher", "reviewer", "planner"],
      "description": "Type of agent to execute this task",
      "default": "worker"
    },
    "description": {
      "type": "string",
      "maxLength": 5000,
      "description": "Detailed task description (markdown supported)"
    },
    "priority": {
      "type": "string",
      "enum": ["P1", "P2", "P3"],
      "description": "Task priority level",
      "default": "P2"
    },
    "depends": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "description": "List of task IDs this task depends on",
      "default": []
    },
    "source": {
      "type": "string",
      "description": "Source document or plan this task originated from",
      "examples": ["DOCGEN_DOCSITE_IMPROVEMENT_PLAN.md", "WORK_STREAM.md"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "estimated_hours": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "Estimated hours to complete"
        },
        "complexity": {
          "type": "string",
          "enum": ["simple", "moderate", "complex"],
          "description": "Task complexity level"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags for categorization",
          "default": []
        },
        "assignee": {
          "type": "string",
          "description": "Assigned agent or user"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 creation timestamp"
        },
        "updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 last update timestamp"
        },
        "related_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": "Related task IDs (not dependencies)"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["article", "documentation", "code", "issue"]
              },
              "file": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "implementation_details": {
      "type": "string",
      "description": "Technical implementation details (markdown supported)",
      "maxLength": 10000
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "description"],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "description": "Step number"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Step description"
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Deliverables for this step",
            "default": []
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 0,
            "description": "Estimated minutes for this step"
          }
        },
        "additionalProperties": false
      },
      "description": "Step-by-step instructions",
      "default": []
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Expected outputs from this task",
      "default": []
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Acceptance criteria for task completion",
      "default": []
    },
    "research_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Research questions (for researcher tasks)",
      "default": []
    },
    "expected_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Expected research outcomes",
      "default": []
    },
    "methodology": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Research methodology",
      "default": []
    },
    "review_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Review criteria (for reviewer tasks)",
      "default": []
    },
    "files_to_review": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Files to review",
      "default": []
    },
    "quality_gates": {
      "type": "object",
      "properties": {
        "code_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "type_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "linter_errors": {
          "type": "integer",
          "minimum": 0
        },
        "test_failures": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private", "restricted", "internal"],
      "description": "Task visibility level",
      "default": "public"
    },
    "allowed_agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Allowed agents for restricted tasks",
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subagent_type": {
            "const": "worker"
          }
        },
        "required": ["subagent_type"]
      },
      "then": {
        "properties": {
          "steps": {
            "minItems": 1
          },
          "deliverables": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subagent_type": {
            "const": "researcher"
          }
        },
        "required": ["subagent_type"]
      },
      "then": {
        "properties": {
          "research_questions": {
            "minItems": 1
          },
          "expected_outcomes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subagent_type": {
            "const": "reviewer"
          }
        },
        "required": ["subagent_type"]
      },
      "then": {
        "properties": {
          "review_criteria": {
            "minItems": 1
          },
          "files_to_review": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "restricted"
          }
        },
        "required": ["visibility"]
      },
      "then": {
        "properties": {
          "allowed_agents": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
