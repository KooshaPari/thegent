{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thegent.dev/schemas/thegent-hooks-result-v1.schema.json",
  "title": "thegent-hooks result envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "hook",
    "generated_at",
    "status",
    "exit_code",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "thegent-hooks-result/v1"
    },
    "hook": {
      "type": "string",
      "enum": ["quality-gate", "security-pipeline"]
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "skipped", "advisory", "done"]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "minProperties": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped", "warn"]
          },
          "findings": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
