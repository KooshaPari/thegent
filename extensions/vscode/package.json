{
  "name": "thegent-vscode",
  "displayName": "thegent",
  "description": "VS Code extension for thegent — MCP client + session management UI (WL-117)",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=18.0.0"
  },
  "categories": ["Other", "Machine Learning"],
  "keywords": ["thegent", "ai", "agent", "mcp", "session"],
  "activationEvents": [
    "onCommand:thegent.start",
    "onCommand:thegent.listSessions",
    "onCommand:thegent.resume",
    "onCommand:thegent.startSession",
    "onCommand:thegent.submitTurn",
    "onCommand:thegent.showSessions",
    "onView:thegentSessions"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "thegent.start",
        "title": "thegent: Start New Session",
        "icon": "$(play)"
      },
      {
        "command": "thegent.listSessions",
        "title": "thegent: List Sessions",
        "icon": "$(list-unordered)"
      },
      {
        "command": "thegent.resume",
        "title": "thegent: Resume Session",
        "icon": "$(debug-continue)"
      },
      {
        "command": "thegent.startSession",
        "title": "thegent: Start Session"
      },
      {
        "command": "thegent.submitTurn",
        "title": "thegent: Submit Turn"
      },
      {
        "command": "thegent.showSessions",
        "title": "thegent: Show Sessions"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "thegentSessions",
          "name": "thegent Sessions",
          "when": "true",
          "icon": "$(robot)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "thegent.start",
          "when": "view == thegentSessions",
          "group": "navigation"
        },
        {
          "command": "thegent.listSessions",
          "when": "view == thegentSessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "thegent.resume",
          "when": "view == thegentSessions && viewItem == session",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "thegent",
      "properties": {
        "thegent.agentServerCommand": {
          "type": "string",
          "default": "thegent",
          "description": "Path or command to invoke thegent agent-server binary"
        },
        "thegent.agentServerArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["agent-server"],
          "description": "Arguments passed to thegent agent-server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "pretest": "npm run compile && tsc -p ./tsconfig.test.json && cp src/__tests__/run-tests.js out/__tests__/run-tests.js",
    "lint": "eslint src --ext ts",
    "test": "node ./test/protocolClient.test.js && node ./out/__tests__/run-tests.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  }
}
