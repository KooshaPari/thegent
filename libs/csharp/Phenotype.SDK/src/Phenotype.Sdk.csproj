<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Phenotype.Sdk</RootNamespace>
    <AssemblyName>Phenotype.Sdk</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>Phenotype Team</Authors>
    <Description>Phenotype SDK for configuration management</Description>
    <PackageProjectUrl>https://github.com/phenotype/phenotype-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/phenotype/phenotype-sdk</RepositoryUrl>
    <License>MIT</License>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
