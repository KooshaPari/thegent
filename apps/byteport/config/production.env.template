# BytePort Production Environment Configuration
# Copy this file and fill in actual values
# NEVER commit filled values to version control

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
ENVIRONMENT=production
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# SERVICE PORTS
# =============================================================================
API_PORT=8080
FRONTEND_PORT=3000

# =============================================================================
# DATABASE
# =============================================================================
# Production PostgreSQL connection string
DATABASE_URL=postgresql://byteport_prod:CHANGE_ME@db.production.example.com:5432/byteport_prod
DATABASE_MAX_CONNECTIONS=50
DATABASE_SSL_MODE=require

# =============================================================================
# BACKEND API
# =============================================================================
PORT=8080
HOST=0.0.0.0
BASE_URL=https://byte.kooshapari.com

# CORS Configuration
CORS_ORIGINS=https://byte.kooshapari.com
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# WorkOS Production Credentials
WORKOS_API_KEY=sk_live_CHANGE_ME
WORKOS_CLIENT_ID=client_CHANGE_ME

# JWT Configuration (MUST be 32+ characters)
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_EXPIRY=24h

# Encryption (MUST be exactly 32 bytes)
ENCRYPTION_KEY=CHANGE_ME_EXACTLY_32_CHARACTERS

# CSRF Protection (MUST be 32+ characters)
CSRF_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# =============================================================================
# CLOUD PROVIDERS
# =============================================================================
# AWS Configuration
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1

# GCP Configuration
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-credentials.json
GCP_PROJECT_ID=byteport-production

# Azure Configuration
AZURE_SUBSCRIPTION_ID=CHANGE_ME
AZURE_TENANT_ID=CHANGE_ME
AZURE_CLIENT_ID=CHANGE_ME
AZURE_CLIENT_SECRET=CHANGE_ME

# =============================================================================
# OBSERVABILITY
# =============================================================================
# Metrics & Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Sentry Error Tracking
SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Distributed Tracing
ENABLE_TRACING=true
JAEGER_ENDPOINT=https://jaeger.production.example.com/api/traces

# =============================================================================
# FRONTEND (Next.js)
# =============================================================================
# API Configuration
NEXT_PUBLIC_API_URL=https://byte.kooshapari.com/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# WorkOS Frontend Configuration
NEXT_PUBLIC_WORKOS_CLIENT_ID=client_CHANGE_ME
WORKOS_REDIRECT_URI=https://byte.kooshapari.com/auth/callback

# Feature Flags
NEXT_PUBLIC_ENABLE_SSE_LOGS=true
NEXT_PUBLIC_ENABLE_METRICS=true
NEXT_PUBLIC_ENABLE_COST_TRACKING=true

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-CHANGE_ME
NEXT_PUBLIC_SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_INTERVAL=30s

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30s

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================
# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# S3 Backup Storage
BACKUP_S3_BUCKET=byteport-backups-prod
BACKUP_S3_REGION=us-east-1

# =============================================================================
# NOTES
# =============================================================================
# 1. Generate secure secrets:
#    openssl rand -base64 32
#
# 2. Validate JWT_SECRET length:
#    echo -n "$JWT_SECRET" | wc -c  # Must be >= 32
#
# 3. Test database connection:
#    psql "$DATABASE_URL" -c "SELECT 1"
#
# 4. Never commit this file with real values
#
# 5. Rotate secrets regularly:
#    - JWT_SECRET: Every 90 days
#    - API keys: Every 180 days
#    - Encryption keys: Annually
