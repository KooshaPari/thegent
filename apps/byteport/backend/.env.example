# BytePort Backend Environment Configuration

# ================================
# Database Configuration
# ================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgresql://byteport:byteport@localhost:54321/byteport?sslmode=disable

# For production, use SSL
# DATABASE_URL=postgresql://byteport:password@prod-host:5432/byteport?sslmode=require

# ================================
# Redis Configuration
# ================================
REDIS_URL=redis://localhost:63790
REDIS_PASSWORD=

# ================================
# API Server Configuration
# ================================
PORT=8081
API_BASE_URL=http://localhost:8081
GIN_MODE=debug
# For production: GIN_MODE=release

# ================================
# CORS Configuration
# ================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://tauri.localhost

# ================================
# JWT & Authentication
# ================================
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

# ================================
# Cloud Provider API Keys
# ================================

# Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Render
RENDER_API_KEY=

# Supabase
SUPABASE_API_KEY=
SUPABASE_ORG_ID=
SUPABASE_ACCESS_TOKEN=

# Neon
NEON_API_KEY=

# Upstash
UPSTASH_API_KEY=
UPSTASH_EMAIL=

# Fly.io
FLY_API_TOKEN=

# Railway
RAILWAY_API_TOKEN=

# ================================
# AWS Credentials (Optional)
# ================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ================================
# Host Agent Configuration
# ================================
HOST_AGENT_API_KEY=your-host-agent-secret-key
HOST_AGENT_PORT=9000

# ================================
# LLM Configuration (Optional)
# ================================
# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# ================================
# Logging & Monitoring
# ================================
LOG_LEVEL=info
# Options: debug, info, warn, error

LOG_FORMAT=json
# Options: json, text

# Sentry (Optional)
SENTRY_DSN=

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_TIER=100
RATE_LIMIT_PRO_TIER=1000

# ================================
# Feature Flags
# ================================
ENABLE_AUTO_DETECTION=true
ENABLE_COST_ESTIMATION=true
ENABLE_SELF_HOSTED=true

# ================================
# NVMS Service (Internal)
# ================================
NVMS_SERVICE_URL=http://localhost:3000
NVMS_TOKEN_SECRET=your-nvms-token-secret

# ================================
# Encryption
# ================================
ENCRYPTION_KEY=your-32-byte-encryption-key-here-change-in-production

# ================================
# Development Settings
# ================================
DEV_MODE=true
MOCK_PROVIDERS=false
SKIP_SSL_VERIFY=true
