# BytePort Backend Environment Configuration
# Using same PostgreSQL as Zen MCP Server

# ================================
# Database Configuration
# ================================
# PostgreSQL connection string - same as Zen MCP (GORM format, not URL format)
DATABASE_URL=host=localhost user=zen password=zen dbname=zen_mcp port=5432 sslmode=disable

# ================================
# Redis Configuration
# ================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ================================
# API Server Configuration
# ================================
PORT=8080
API_BASE_URL=http://localhost:8080
GIN_MODE=debug

# ================================
# CORS Configuration
# ================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://tauri.localhost,https://byte.kooshapari.com

# ================================
# JWT & Authentication
# ================================
JWT_SECRET=byteport-dev-secret-key-change-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

# WorkOS / AuthKit configuration (mirrors frontend values)
WORKOS_CLIENT_ID=client_01K4KYZR40RK7R9X3PPB5SEJ66
WORKOS_REDIRECT_URI=https://byte.kooshapari.com/auth/callback
WORKOS_AUTHKIT_DOMAIN=https://significant-vessel-93-staging.authkit.app
WORKOS_CLIENT_SECRET=f52b84bfa0bfba6c1554a8db1b14bc1fcec27fb59970a1204f6d23927749e9b9
WORKOS_API_KEY=sk_test_a2V5XzAxSzRLWVpRSkFNUURWS0tWR0JZQVFGUkZWLGNsYmZHcTZmTVc0bFlicHA3bXNjMEpIVTE

# ================================
# Cloud Provider API Keys
# ================================

# Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Render
RENDER_API_KEY=

# Supabase
SUPABASE_API_KEY=
SUPABASE_ORG_ID=
SUPABASE_ACCESS_TOKEN=

# Neon
NEON_API_KEY=

# Upstash
UPSTASH_API_KEY=
UPSTASH_EMAIL=

# Fly.io
FLY_API_TOKEN=

# Railway
RAILWAY_API_TOKEN=

# ================================
# AWS Credentials (Optional)
# ================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ================================
# Host Agent Configuration
# ================================
HOST_AGENT_API_KEY=byteport-host-agent-dev-key
HOST_AGENT_PORT=9000

# ================================
# LLM Configuration (Optional)
# ================================
# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# ================================
# Logging & Monitoring
# ================================
LOG_LEVEL=info
LOG_FORMAT=json

# Sentry (Optional)
SENTRY_DSN=

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_TIER=100
RATE_LIMIT_PRO_TIER=1000

# ================================
# Feature Flags
# ================================
ENABLE_AUTO_DETECTION=true
ENABLE_COST_ESTIMATION=true
ENABLE_SELF_HOSTED=true

# ================================
# NVMS Service (Internal)
# ================================
NVMS_SERVICE_URL=http://localhost:3000
NVMS_TOKEN_SECRET=nvms-dev-token-secret

# ================================
# Encryption
# ================================
ENCRYPTION_KEY=byteport-dev-encryption-key-32b

# ================================
# Development Settings
# ================================
DEV_MODE=true
MOCK_PROVIDERS=false
SKIP_SSL_VERIFY=true
