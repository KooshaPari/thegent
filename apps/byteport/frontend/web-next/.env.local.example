# Environment mode: set to 'true' to use localhost ports, otherwise uses production URLs
NEXT_PUBLIC_USE_LOCAL=true

# API URLs - defaults to production byte.kooshapari.com unless USE_LOCAL=true
# When USE_LOCAL=true, these will be overridden in config.ts
NEXT_PUBLIC_API_URL=https://byte.kooshapari.com/api/v1
NEXT_PUBLIC_BYTEPORT_API_URL=https://byte.kooshapari.com
NEXT_PUBLIC_DEPLOYMENT_API_URL=https://byte.kooshapari.com/api/v1

# WorkOS AuthKit Configuration
WORKOS_API_KEY='sk_test_your_key_here'
WORKOS_CLIENT_ID='client_your_id_here'
WORKOS_COOKIE_PASSWORD='generate_with_openssl_rand_base64_24'
NEXT_PUBLIC_WORKOS_REDIRECT_URI='https://byte.kooshapari.com/auth/callback'
