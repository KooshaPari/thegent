# Byteport — Self-Hosted Configuration
# Copy to .env (backend) and frontend/web-next/.env.local (frontend), then fill in values.

# ─── Database (local PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/byteport

# ─── Auth (WorkOS) ──────────────────────────────────────────────────────────
# WorkOS free tier is sufficient for self-hosted use.
# Sign up at https://workos.com and create an app.
WORKOS_API_KEY=sk_test_<your_key>
WORKOS_CLIENT_ID=client_<your_id>
# Generate: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=<32-char-random-string>
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# ─── LLM — vLLM or MLX (local, OpenAI-compatible API, no API key required) ──
#
# For macOS / Apple Silicon — use MLX:
#   pip install mlx-lm
#   mlx_lm.server --model mlx-community/Mistral-7B-v0.1-4bit
#   (default port: 8080)
#
# For Linux / prod — use vLLM:
#   pip install vllm
#   vllm serve mistralai/Mistral-7B-v0.1
#   (default port: 8000)
#
# LLM_PROVIDER selects the backend label in the UI. The actual request always goes
# to LLM_BASE_URL, so both vLLM and MLX use the same three env vars.
LLM_PROVIDER=vllm
LLM_BASE_URL=http://localhost:8000
LLM_MODEL=mistralai/Mistral-7B-v0.1
# LLM_API_KEY is optional for local servers; required for cloud providers.
LLM_API_KEY=

# ─── LLM — Cloud providers (optional, only if using a hosted LLM) ───────────
# Uncomment and fill in if you prefer a cloud LLM instead of local vLLM/MLX.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Object / Artifact Storage ──────────────────────────────────────────────
# For local dev, artefacts are written to disk.
# For production self-hosting, point at MinIO (S3-compatible, free & OSS).
#   docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/tmp/byteport-storage
# MinIO (optional, uncomment for production self-host):
# STORAGE_PROVIDER=s3compat
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=byteport

# ─── API / Server ────────────────────────────────────────────────────────────
PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_BYTEPORT_API_URL=http://localhost:8080
NEXT_PUBLIC_USE_LOCAL=true

# ─── Secrets backend ─────────────────────────────────────────────────────────
# Default: environment variables (no external service needed).
# Optional: HashiCorp Vault for production secret management.
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=<root-token>

# ─── AWS (optional — only for AWS deployment targets) ────────────────────────
# Leave empty if you are not deploying to AWS.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
