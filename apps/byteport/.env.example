# BytePort Root Environment Configuration
# Copy this file to .env and fill in your actual values

# Primary API URL (standardized)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Database Configuration
DATABASE_URL=host=localhost user=postgres password=YOUR_DB_PASSWORD dbname=byteport port=5432 sslmode=disable

# WorkOS AuthKit Configuration
# Get these from https://dashboard.workos.com/
WORKOS_API_KEY=sk_test_YOUR_WORKOS_API_KEY
WORKOS_CLIENT_ID=client_YOUR_WORKOS_CLIENT_ID
WORKOS_COOKIE_PASSWORD=YOUR_32_CHAR_RANDOM_STRING
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Legacy Authentication Configuration (deprecated - migrate to WorkOS)
# NEXT_PUBLIC_AUTHKIT_DOMAIN=https://your-domain.authkit.app
# NEXT_PUBLIC_AUTHKIT_CLIENT_ID=client_YOUR_CLIENT_ID
# NEXT_PUBLIC_AUTHKIT_REDIRECT_URI=https://your-domain.com/auth/callback
# NEXT_PUBLIC_AUTHKIT_SCOPES=openid profile email offline_access
# NEXT_PUBLIC_AUTHKIT_AUDIENCE=https://your-domain.com
