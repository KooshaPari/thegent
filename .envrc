# direnv integration for thegent
# MIGRATED TO MISE: This file is kept for backward compatibility only
# Primary environment manager is now mise (see .mise.toml)
#
# CRITICAL: Exit immediately if mise is active to prevent slow direnv loading (3-4s delay)
# mise is faster (<50ms) and handles all environment setup via .mise.toml

# Fast exit checks (before any slow operations) - MUST be first
if [ -n "${MISE_ENV:-}" ]; then
  exit 0
fi

# Check if mise command exists and would handle this directory
# If .mise.toml exists, prefer mise over direnv (mise is 60-80x faster)
if [ -f .mise.toml ] && command -v mise >/dev/null 2>&1; then
  # mise should handle this - exit quickly to avoid direnv overhead
  exit 0
fi

# Non-interactive shell: exit early to prevent hangs
if [ -z "${PS1:-}" ] && [ ! -t 0 ]; then
  exit 0
fi

# Fallback: venv setup (only if mise is not available)
# This is slower but needed for backward compatibility
if [ -d .venv ] && [ ! -f .mise.toml ]; then
  source .venv/bin/activate 2>/dev/null || true
  export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$(pwd)/src"
  export PATH="$(pwd)/.venv/bin:${HOME}/.local/bin:${PATH}"
fi

# Environment variables (mise handles these in .mise.toml)
# Only set if mise is not active
if [ -z "${MISE_ENV:-}" ]; then
  export RIPGREP_CONFIG_PATH=""
  export FUNCNEST=1000
  export THGENT_NOTIFY_ENABLE=1
  export THGENT_NOTIFY_VOICE_MODE=all
  export THGENT_NOTIFY_VOICE_NAME="Samantha"
  export THGENT_NOTIFY_COOLDOWN_SEC=8
  export THGENT_ZEN_BASE_URL="https://api.opencode.ai"
fi
