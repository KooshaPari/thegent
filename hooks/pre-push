#!/bin/bash
# thegent pre-push hook - Full quality suite

set -e

echo "============================================================"
echo "PRE-PUSH: Running full quality suite"
echo "============================================================"

# Run full test suite
echo "Running tests..."
python -m pytest tests/ -x --tb=short -q 2>&1 | tail -20

echo ""
echo "✓ Pre-push checks passed"
exit 0
