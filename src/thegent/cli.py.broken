"""Thegent CLI commands."""

import sys
import time
from typing import Any, Optional

import typer

# Lazy console import (from cli_impl pattern)
class LazyConsole:
    """Lazy-loaded rich console to speed up CLI startup."""
    def __getattr__(self, name):
        from rich.console import Console
        global console
        console = Console()
        return getattr(console, name)

console = LazyConsole()

# Lazy imports for thegent modules
def _lazy_import(module: str, name: str):
    def wrapper(*args, **kwargs):
        import importlib
        m = importlib.import_module(module)
        f = getattr(m, name)
        globals()[name] = f
        return f(*args, **kwargs)
    return wrapper

_normalize_output_format = _lazy_import("thegent.cli_impl", "_normalize_output_format")


"""Thegent CLI commands."""

import csv
import hashlib
import io
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, cast, Optional, Union, List

import typer

def monitor_cmd(
    watch: bool = typer.Option(False, "--watch", "-w", help="Continuously monitor (Ctrl+C to stop)"),
    interval: float = typer.Option(5.0, "--interval", "-i", help="Update interval in seconds"),
    format: Optional[str] = typer.Option(None, "--format", "-f", help="Output format: json, rich, md"),
    include_plan: bool = typer.Option(True, "--plan/--no-plan", help="Include plan progress"),
    include_sessions: bool = typer.Option(True, "--sessions/--no-sessions", help="Include session status"),
) -> None:
    """Monitor sessions and plan progress in real-time.
    
    Provides a unified dashboard showing:
    - Active sessions (running/exited counts)
    - Next work items from plan
    - Resource usage
    
    Use --watch for continuous monitoring.
    """
    from thegent.cli_impl import monitor_impl
    
    if watch:
        import signal
        import sys
        
        def signal_handler(sig, frame):
            console.print("\n[dim]Monitoring stopped.[/dim]")
            sys.exit(0)
        
        signal.signal(signal.SIGINT, signal_handler)
        signal.signal(signal.SIGTERM, signal_handler)
        
        console.print("[bold green]Monitoring sessions and plan progress...[/bold green]")
        console.print("[dim]Press Ctrl+C to stop[/dim]\n")
        
        try:
            while True:
                data = monitor_impl(
                    watch=True,
                    interval=interval,
                    format=format,
                    include_plan=include_plan,
                    include_sessions=include_sessions,
                )
                _render_monitor_output(data, format)
                time.sleep(interval)
                console.print()  # Blank line between updates
        except KeyboardInterrupt:
            console.print("\n[dim]Monitoring stopped.[/dim]")
    else:
        data = monitor_impl(
            watch=False,
            format=format,
            include_plan=include_plan,
            include_sessions=include_sessions,
        )
        _render_monitor_output(data, format)


def _render_monitor_output(data: dict[str, Any], format: Optional[str] = None) -> None:
    """Render monitoring data in the specified format."""
    fmt = _normalize_output_format(format)
    
    if fmt == "json":
        import json
        sys.stdout.write(json.dumps(data, indent=2) + "\n")
        return
    
    # Rich format (default)
    from rich.table import Table
    from rich.panel import Panel
    
    # Sessions summary
    if "sessions" in data and data["sessions"]:
        sessions = data["sessions"]
        sessions_table = Table(title="Sessions", show_header=True, header_style="bold magenta")
        sessions_table.add_column("Metric", style="cyan")
        sessions_table.add_column("Value", style="green")
        sessions_table.add_row("Total", str(sessions.get("total", 0)))
        sessions_table.add_row("Running", str(sessions.get("running", 0)))
        sessions_table.add_row("Exited", str(sessions.get("exited", 0)))
        console.print(sessions_table)
        console.print()
    
    # Plan progress
    if "plan_progress" in data and data["plan_progress"]:
        plan = data["plan_progress"]
        if plan.get("error"):
            console.print(f"[red]Plan Error: {plan['error']}[/red]")
        elif plan.get("next_item"):
            next_item = plan["next_item"]
            console.print(Panel(
                f"[bold]Next Work Item:[/bold] {next_item.get('id', 'N/A')}\n"
                f"[dim]{next_item.get('title', '')}[/dim]",
                title="Plan Progress",
                border_style="green"
            ))
        else:
            console.print("[dim]No pending work items[/dim]")
    
    # Timestamp
    if "timestamp" in data:
        console.print(f"\n[dim]Updated: {data['timestamp']}[/dim]")
