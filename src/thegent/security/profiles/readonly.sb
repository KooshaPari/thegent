;;; macOS Seatbelt profile: readonly
;;; Allows reading the filesystem, process execution, and basic system calls.
;;; Denies all writes, network access, and IPC.
(version 1)
(deny default)

;;; Allow process execution (required for the sandboxed process itself)
(allow process-exec)
(allow process-fork)

;;; Allow signal delivery (e.g. SIGTERM to self)
(allow signal (target self))

;;; Allow file reads across the entire filesystem
(allow file-read*)

;;; Allow reading from /dev (required for stdin/stdout/stderr and tty)
(allow file-read-data (subpath "/dev"))
(allow file-write-data
    (literal "/dev/null")
    (literal "/dev/stdout")
    (literal "/dev/stderr"))

;;; Allow reading system configuration
(allow file-read-metadata)

;;; Allow sysctl reads (used by Python, shell tools)
(allow sysctl-read)

;;; Allow mach lookups for basic system services
(allow mach-lookup
    (global-name "com.apple.system.logger")
    (global-name "com.apple.system.notification_center"))

;;; Allow POSIX IPC (semaphores for multiprocessing)
(allow ipc-posix-sem)
(allow ipc-posix-shm-read*)

;;; Allow network on loopback only (for localhost tools)
;;; Deny all external network
(deny network*)
