index 981eefd08..410645f19 100644
--- a/crates/harness-native/src/strategies/incremental.rs
+++ b/crates/harness-native/src/strategies/incremental.rs
@@ -14,14 +14,20 @@ pub fn run(real_cmd: &Path, args: &[&str]) -> Result<i32, String> {
             let stderr = child.stderr.take();
 
             if let Some(stdout) = stdout {
-                for line in BufReader::new(stdout).lines().map_while(Result::ok) {
-                    println!("{}", line);
+                for line in BufReader::new(stdout).lines() {
+                    match line {
+                        Ok(line) => println!("{}", line),
