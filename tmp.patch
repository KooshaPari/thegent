             }
 
             if let Some(stderr) = stderr {
-                for line in BufReader::new(stderr).lines().map_while(Result::ok) {
-                    eprintln!("{}", line);
+                for line in BufReader::new(stderr).lines() {
+                    match line {
+                        Ok(line) => eprintln!("{}", line),
+                        Err(_) => continue,
+                    }
                 }
             }
 
