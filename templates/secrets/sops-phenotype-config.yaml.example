# SOPS configuration for Phenotype secrets
# Age-based encryption (modern, post-quantum ready)
#
# Setup:
#   1. Generate age key: age-keygen -o ~/.config/age/phenotype.key
#   2. Get public key: age-keygen -y ~/.config/age/phenotype.key
#   3. Replace age1xxxx below with your public key
#   4. Encrypt: sops --encrypt secrets.env > secrets.env.age
#
# Multi-recipient (for team sharing):
#   - Add each device's age public key to the age list
#   - Anyone with ANY private key can decrypt

creation_rules:
  - path_regex: secrets/.*
    age: >-
      age1e7enhngqnwd9syl2spwrsf5v56m7cjlzxw9dr5mk44dchfyl4ycqxvx83z,
      age1jyx6mylyjd6wsgwgy4cyhg7mnagvy4ksehgpaaq7ll7g6zvsmgkqwlrlkh

  - path_regex: \.env$
    age: >-
      age1e7enhngqnwd9syl2spwrsf5v56m7cjlzxw9dr5mk44dchfyl4ycqxvx83z,
      age1jyx6mylyjd6wsgwgy4cyhg7mnagvy4ksehgpaaq7ll7g6zvsmgkqwlrlkh
