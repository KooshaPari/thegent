# Phenotype secrets template — COPY THIS TO secrets.env AND FILL IN VALUES
# THEN ENCRYPT WITH: sops --encrypt secrets.env > secrets.env.age

# MiniMax API Key (get from https://platform.minimaxi.com/)
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_API_KEY_GROUP=default

# Optional: Vault path (if using HashiCorp Vault)
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=your-vault-token-here
# VAULT_MINIMAX_PATH=secret/phenotype/minimax
