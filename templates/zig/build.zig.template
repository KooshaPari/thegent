const std = @import("std");

// This build script configures compilation for the {{ project_name }} project.
// Uses Zig 0.14 stable build system API.

pub fn build(b: *std.Build) void {
    // Target and optimization settings
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});

    // Main executable target
    const exe = b.addExecutable(.{
        .name = "{{ project_name | replace('-', '_') }}",
        .root_source_file = b.path("src/main.zig"),
        .target = target,
        .optimize = optimize,
    });

    // Install the executable to zig-cache/bin
    b.installArtifact(exe);

    // Create a run step: `zig build run`
    const run_cmd = b.addRunArtifact(exe);
    run_cmd.step.dependOn(b.getInstallStep());

    // Allow passing arguments to the executable: `zig build run -- arg1 arg2`
    if (b.args) |args| {
        run_cmd.addArgs(args);
    }

    const run_step = b.step("run", "Run the application");
    run_step.dependOn(&run_cmd.step);

    // Unit tests: `zig build test`
    const unit_tests = b.addTest(.{
        .root_source_file = b.path("src/main.zig"),
        .target = target,
        .optimize = optimize,
    });

    const run_unit_tests = b.addRunArtifact(unit_tests);

    const test_step = b.step("test", "Run unit tests");
    test_step.dependOn(&run_unit_tests.step);

    // Integration tests (optional): place test files in tests/ directory
    // const integration_tests = b.addTest(.{
    //     .root_source_file = b.path("tests/integration.zig"),
    //     .target = target,
    //     .optimize = optimize,
    // });
    // const run_integration_tests = b.addRunArtifact(integration_tests);
    // test_step.dependOn(&run_integration_tests.step);
}
