# Dockerfile - Python
FROM python:3.12-slim

# Install uv for fast package management
RUN pip install uv

# Set working directory
WORKDIR /app

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies
RUN uv sync --frozen --no-dev

# Copy source code
COPY src/ ./src/

# Set environment
ENV PYTHONPATH=/app

# Default command
CMD ["python", "-m", "app"]
