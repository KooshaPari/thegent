{
  "$schema": "https://schema.thegent.dev/system-manifest/v1",
  "version": "1.0.0",
  "name": "thegent-system",
  "description": "Comprehensive system configuration manifest - Nix-like declarative system management",
  "targets": {
    "harnesses": {
      "claude-code": {
        "config_paths": [
          "~/.claude"
        ],
        "files": {
          "skills": "~/.claude/skills",
          "hooks": "~/.claude/hooks",
          "commands": "~/.claude/commands"
        }
      },
      "claude-desktop": {
        "config_paths": [
          "~/.config/Claude",
          "~/Library/Application Support/Claude"
        ],
        "platforms": [
          "darwin",
          "linux"
        ]
      },
      "cursor": {
        "config_paths": [
          "~/.cursor"
        ],
        "files": {
          "skills": "~/.cursor/skills-cursor"
        }
      },
      "codex": {
        "config_paths": [
          "~/.codex",
          "~/.config/codex"
        ],
        "files": {
          "mcp": "~/.codex/mcp.json"
        }
      },
      "droid": {
        "config_paths": [
          "~/.factory"
        ],
        "description": "Factory Droid"
      },
      "ante": {
        "config_paths": [
          "~/.ante"
        ],
        "description": "Ante CLI"
      },
      "helios": {
        "config_paths": [
          "~/.helios"
        ],
        "description": "Helios harness"
      }
    },
    "shells": {
      "zsh": {
        "config_files": [
          "~/.zshenv",
          "~/.zshrc",
          "~/.zsh_bundle.zsh",
          "~/.zsh_safeguards.zsh",
          "~/.zsh_optimization.zsh",
          "~/.zsh_advanced.zsh",
          "~/.zsh_worktree_governance.zsh"
        ],
        "source": "thegent/shell"
      },
      "bash": {
        "config_files": [
          "~/.bashrc",
          "~/.bash_profile"
        ],
        "source": "thegent/templates/bash"
      },
      "fish": {
        "config_files": [
          "~/.config/fish"
        ],
        "source": "thegent/templates/fish"
      },
      "powershell": {
