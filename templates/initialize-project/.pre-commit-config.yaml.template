repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: check-yaml
        stages: [pre-commit, pre-push]
        args: ["--unsafe"]
      - id: check-toml
        stages: [pre-commit, pre-push]
      - id: check-json
        stages: [pre-commit, pre-push]
      - id: trailing-whitespace
        stages: [pre-commit, pre-push]
      - id: end-of-file-fixer
        stages: [pre-commit, pre-push]
      - id: check-added-large-files
        stages: [pre-commit, pre-push]
        args: ["--maxkb=500"]
      - id: detect-private-key
        stages: [pre-commit, pre-push]
        exclude: |
          (?x)^(
            tests/.+\.pem$|
            .thegent/sessions/keys/.*\.pem$
          )$
      - id: no-commit-to-branch
        stages: [pre-commit, pre-push]
        args: ["--branch", "main", "--branch", "master"]

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.10.0
    hooks:
      - id: ruff
        stages: [pre-commit, pre-push]
        args: ["--fix"]
      - id: ruff-format
        stages: [pre-commit, pre-push]

  - repo: local
    hooks:
      - id: trufflehog
        name: TruffleHog Secret Detection
        entry: trufflehog git file://. --since-commit HEAD --only-verified --fail
        language: system
        pass_filenames: false
        stages: [pre-commit]
        stages: [pre-commit, pre-push]

  - repo: local
    hooks:
      - id: commit-msg-check
        name: Commit message should be non-empty
        stages: [commit-msg]
        language: system
        entry: bash -c 'msg_file="$1"; test -s "$msg_file" && ! grep -Eq "^[[:space:]]*$" "$msg_file"'
        pass_filenames: true

      - id: ty
        name: Fast Type Check (ty)
        entry: uv run ty check src/
        language: system
        stages: [commit, pre-commit, pre-push]
        pass_filenames: false
        types: [python]

      - id: basedpyright
        name: Strict Type Check (basedpyright)
        entry: uv run basedpyright src/
        language: system
        stages: [commit, pre-commit, pre-push]
        pass_filenames: false
        types: [python]

{% if include_act %}
      - id: ci-local-gh-push
        name: Run local CI on push hooks
        entry: task ci:local-gh:push
        language: system
        stages: [pre-push]
        pass_filenames: false

      - id: ci-local-gh-pr
        name: Run local CI on pull_request hooks
        entry: task ci:local-gh:pr
        language: system
        stages: [pre-push]
        pass_filenames: false
{% endif %}
