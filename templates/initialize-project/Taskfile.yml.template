# =============================================================================
# {{project_name}} - Taskfile
# =============================================================================
# Generated from {{language}} template
# Author: {{author}}
# =============================================================================

version: '3'

vars:
  PROJECT_NAME: "{{project_name}}"

{% if include_qa_tools %}
includes:
  quality:
    taskfile: ./templates/shared/Taskfile.quality.yml
    optional: true
{% endif %}

tasks:
  default:
    cmds:
      - task --list
    silent: true

{% if include_hooks %}
  hooks:install:
    desc: "Install git hooks (pre-commit, pre-push, commit-msg)"
    cmds:
      - uv run pre-commit install
      - uv run pre-commit install --hook-type pre-push
      - uv run pre-commit install --hook-type commit-msg

  hooks:run:
    desc: "Run full local pre-commit checks"
    cmds:
      - uv run pre-commit run --all-files
      - echo "Pre-commit parity check completed"

  hooks:run:pre-commit:
    desc: "Run configured pre-commit hooks for pre-commit stage"
    cmds:
      - uv run pre-commit run --all-files --hook-stage pre-commit

  hooks:run:pre-push:
    desc: "Run configured pre-commit hooks for pre-push stage"
    cmds:
      - uv run pre-commit run --all-files --hook-stage pre-push
{% endif %}

  ci:local:
    desc: "Run local CI-like checks (hooks + quality)."
    cmds:
{% if include_hooks %}
      - task: hooks:run
{% endif %}
      - task: quality

  ci:local:pre-commit:
    desc: "Run only local pre-commit hooks."
    cmds:
      - task: hooks:run:pre-commit

  ci:local:pre-push:
    desc: "Run only local pre-push hooks."
    cmds:
      - task: hooks:run:pre-push

  ci:local:push:
    desc: "Run pre-push hooks plus lightweight quality lane."
    cmds:
      - task: hooks:run:pre-push
      - task: quality

{% if include_act %}
  ci:local-gh:
    desc: "Run local CI workflow with act (push event) for parity."
    cmds:
      - task: ci:local-gh:push

  ci:local-gh:push:
    desc: "Run local GH Actions emulation for push event."
    cmds:
      - chmod +x scripts/ci_local_gha.sh
      - THGENT_ACT_EVENT=push ./scripts/ci_local_gha.sh

  ci:local-gh:pr:
    desc: "Run local GH Actions emulation for pull_request event."
    cmds:
      - chmod +x scripts/ci_local_gha.sh
      - THGENT_ACT_EVENT=pull_request ./scripts/ci_local_gha.sh

  ci:local-gh:dockerless:
    desc: "Run local GH Actions emulation in dockerless mode (PR-like lane)."
    cmds:
      - chmod +x scripts/ci_local_gha.sh
      - THGENT_ACT_DOCKERLESS=1 THGENT_ACT_EVENT=pull_request ./scripts/ci_local_gha.sh

  ci:local-gh:push:dockerless:
    desc: "Run local GH Actions emulation in dockerless mode for push lane."
    cmds:
      - chmod +x scripts/ci_local_gha.sh
      - THGENT_ACT_DOCKERLESS=1 THGENT_ACT_EVENT=push ./scripts/ci_local_gha.sh

  ci:local-gh:pre-commit:
    desc: "Run dockerless local pre-commit hooks lane through the act runner script."
    cmds:
      - chmod +x scripts/ci_local_gha.sh
      - THGENT_ACT_DOCKERLESS=1 THGENT_ACT_EVENT=pull_request THGENT_ACT_JOB=pre-commit ./scripts/ci_local_gha.sh

  ci:local-gh:pre-push:
    desc: "Run dockerless local pre-push hooks lane through the act runner script."
    cmds:
      - chmod +x scripts/ci_local_gha.sh
      - THGENT_ACT_DOCKERLESS=1 THGENT_ACT_EVENT=push THGENT_ACT_JOB=pre-push ./scripts/ci_local_gha.sh
{% endif %}

{% if include_pm_tools %}
  pm:backlog:
    desc: "Show local work-stream backlog snapshot."
    cmds:
      - |
        if [ ! -f docs/reference/WORK_STREAM.md ]; then
          echo "WORK_STREAM missing: docs/reference/WORK_STREAM.md" >&2
          exit 1
        fi
        sed -n '1,120p' docs/reference/WORK_STREAM.md

  pm:next:
    desc: "Show top of backlog for quick execution planning."
    cmds:
      - |
        if [ ! -f docs/reference/WORK_STREAM.md ]; then
          echo "WORK_STREAM missing: docs/reference/WORK_STREAM.md" >&2
          exit 1
        fi
        awk '/^#/{print;next} /^- \[/{print; exit}' docs/reference/WORK_STREAM.md

{% if include_qa_tools %}
  pm:quality-gate:
    desc: "Run QA quality gate task when quality tooling is enabled."
    cmds:
      - task: quality:gate
{% endif %}
{% endif %}

{% if language == "python" %}
  # -- Development --

  dev:
    desc: "Start development environment"
    cmds:
      - echo "Configure your dev environment"

  # -- Testing --

  test:
    desc: "Run all tests"
    cmds:
      - uv run pytest -q

  test:cov:
    desc: "Run tests with coverage"
    cmds:
      - uv run pytest --cov=src --cov-fail-under=80

  # -- Linting --

  lint:
    desc: "Run all linters"
    cmds:
      - uv run ruff check .
      - uv run ruff format --check .

  lint:fix:
    desc: "Fix linting issues"
    cmds:
      - uv run ruff check --fix .
      - uv run ruff format .

  # -- Type Checking --

  typecheck:
    desc: "Fast type checking (ty + zuban)"
    cmds:
      - uv run ty check src/
      - uv run zuban check src/ --disable-error-code call-overload --disable-error-code unreachable --disable-error-code assignment --disable-error-code var-annotated --disable-error-code override --disable-error-code return-value --disable-error-code arg-type --disable-error-code union-attr --disable-error-code dict-item --disable-error-code misc --disable-error-code no-redef --disable-error-code call-arg --disable-error-code operator

  typecheck:strict:
    desc: "Strict type checking (basedpyright + mypy) - recommended for CI/commit"
    cmds:
      - uv run basedpyright src/
      - uv run mypy src/

  # -- Formatting --

  format:
    desc: "Format code"
    cmds:
      - uv run ruff format .

  # -- Quality --

  quality:
    desc: "Run quality gates"
    cmds:
      - task: lint
      - task: typecheck
      - task: test

{% elif language == "typescript" %}
  # -- Development --

  dev:
    desc: "Start development environment"
    cmds:
      - pnpm dev

  # -- Testing --

  test:
    desc: "Run all tests"
    cmds:
      - pnpm vitest run

  test:watch:
    desc: "Run tests in watch mode"
    cmds:
      - pnpm vitest

  # -- Linting --

  lint:
    desc: "Run all linters"
    cmds:
      - pnpm oxlint
      - pnpm prettier --check .

  lint:fix:
    desc: "Fix linting issues"
    cmds:
      - pnpm oxlint --fix
      - pnpm prettier --write .

  # -- Type Checking --

  typecheck:
    desc: "Run type checker"
    cmds:
      - pnpm tsc --noEmit

  # -- Building --

  build:
    desc: "Build the project"
    cmds:
      - pnpm build

  # -- Quality --

  quality:
    desc: "Run quality gates"
    cmds:
      - task: lint
      - task: typecheck
      - task: test

{% elif language == "go" %}
  # -- Development --

  dev:
    desc: "Start development environment"
    cmds:
      - echo "Configure your dev environment"

  # -- Testing --

  test:
    desc: "Run all tests"
    cmds:
      - go test -v ./...

  test:cover:
    desc: "Run tests with coverage"
    cmds:
      - go test -cover ./...

  # -- Linting --

  lint:
    desc: "Run all linters"
    cmds:
      - golangci-lint run

  # -- Building --

  build:
    desc: "Build the project"
    cmds:
      - go build -o bin/{{project_name}} .

  # -- Quality --

  quality:
    desc: "Run quality gates"
    cmds:
      - task: lint
      - task: test

{% elif language == "bash" %}
  # -- Development --

  dev:
    desc: "Start development environment"
    cmds:
      - echo "Configure your dev environment"

  # -- Testing --

  test:
    desc: "Run all tests"
    cmds:
      - bats tests/

  # -- Linting --

  lint:
    desc: "Run all linters"
    cmds:
      - shellcheck -x scripts/**/*.sh

  # -- Quality --

  quality:
    desc: "Run quality gates"
    cmds:
      - task: lint
      - task: test

{% endif %}

{% if include_docs %}
  docs:build:
    desc: "Build documentation site"
    cmds:
      - pnpm docs:build

  docs:dev:
    desc: "Start documentation dev server"
    cmds:
      - pnpm docs:dev
{% endif %}

  # -- Cleanup --

  clean:
    desc: "Clean build artifacts"
    cmds:
      - rm -rf .venv/
      - rm -rf dist/
      - rm -rf .pytest_cache/
      - rm -rf .ruff_cache/
