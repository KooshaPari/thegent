{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thegent.example/schema/phase3-6-closure-validator/v1",
  "title": "thegent phase 3-6 closure acceptance pack schema",
  "type": "object",
  "required": [
    "phase",
    "bundle_id",
    "wp_id",
    "wp_title",
    "owner_team",
    "completion_timestamp",
    "evidence_pack",
    "test_pack",
    "signoff_pack",
    "continuity_pack",
    "governance_pack",
    "risk_pack",
    "rollback_pack",
    "drift_pack",
    "validation_result",
    "next_phase_readiness"
  ],
  "properties": {
    "phase": {
      "type": "integer",
      "minimum": 3,
      "maximum": 6
    },
    "bundle_id": {
      "type": "string",
      "minLength": 3
    },
    "wp_id": {
      "type": "string",
      "pattern": "^WP-(0[3-6][0-9]{3}|100[0-9]{2}|110[0-9]{2}|120[0-9]{2})$"
    },
    "wp_title": {
      "type": "string",
      "minLength": 1
    },
    "owner_team": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "completion_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_pack": {
      "type": "object",
      "required": ["artifacts", "coverage_ratio", "critical_missing"],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact_path", "type", "sha256", "created_at", "evidence_scope"],
            "properties": {
              "artifact_path": { "type": "string", "minLength": 3 },
              "type": {
                "type": "string",
                "enum": ["markdown", "json", "ndjson", "yaml", "text", "binary"]
              },
              "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              "created_at": { "type": "string", "format": "date-time" },
              "evidence_scope": {
                "type": "string",
                "enum": ["unit", "integration", "manual", "security", "operational"]
              },
              "run_id": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "coverage_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "critical_missing": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "test_pack": {
      "type": "object",
      "required": ["tests_required", "tests_run", "test_coverage", "pass"],
      "properties": {
        "tests_required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "tests_run": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "evidence"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": {
                "type": "string",
                "enum": ["passed", "failed", "blocked", "not_run"]
              },
              "evidence": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "test_coverage": {
          "type": "object",
          "required": ["line", "branch", "requirement_coverage"],
          "properties": {
            "line": { "type": "number", "minimum": 0, "maximum": 1 },
            "branch": { "type": "number", "minimum": 0, "maximum": 1 },
            "requirement_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "pass": { "type": "boolean" }
      }
    },
    "signoff_pack": {
      "type": "object",
      "required": ["platform_lead", "governance_lead", "qa_lead"],
      "properties": {
        "platform_lead": { "$ref": "#/$defs.signoffEntry" },
        "governance_lead": { "$ref": "#/$defs.signoffEntry" },
        "qa_lead": { "$ref": "#/$defs.signoffEntry" },
        "security_signoff": { "$ref": "#/$defs.signoffEntry" },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "approved_by", "expires_at"],
            "properties": {
              "code": {
                "type": "string",
                "enum": ["DOCS_OVERRUN", "ENV_VARIANCE", "MIGRATION_WINDOW"]
              },
              "approved_by": { "type": "string", "minLength": 1 },
              "expires_at": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "continuity_pack": {
      "type": "object",
      "required": [
        "legacy_contracts_preserved",
        "bridging_rules_valid",
        "continuity_checks_passed",
        "continuity_checks_failed"
      ],
      "properties": {
        "legacy_contracts_preserved": { "type": "boolean" },
        "bridging_rules_valid": { "type": "boolean" },
        "crosswave_risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["risk_id", "level", "owner", "mitigation"],
            "properties": {
              "risk_id": { "type": "string" },
              "level": { "type": "string", "enum": ["low", "medium", "high"] },
              "owner": { "type": "string" },
              "mitigation": { "type": "string" }
            }
          }
        },
        "continuity_checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "continuity_checks_failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "governance_pack": {
      "type": "object",
      "required": ["governance_version", "policy_version", "deviation_log"],
      "properties": {
        "governance_version": { "type": "string", "minLength": 1 },
        "policy_version": { "type": "string", "minLength": 1 },
        "deviation_log": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "owner", "date"],
            "properties": {
              "id": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["resolved", "open", "escalated"]
              },
              "owner": { "type": "string" },
              "date": { "type": "string", "format": "date" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "risk_pack": {
      "type": "object",
      "required": ["open_risks", "mitigated_count", "critical_risks"],
      "properties": {
        "open_risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "owner", "mitigation"],
            "properties": {
              "id": { "type": "string" },
              "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
              "owner": { "type": "string" },
              "mitigation": { "type": "string" }
            }
          }
        },
        "mitigated_count": { "type": "integer", "minimum": 0 },
        "critical_risks": { "type": "integer", "minimum": 0 }
      }
    },
    "rollback_pack": {
      "type": "object",
      "required": [
        "rollback_token_required",
        "rollback_token",
        "rollback_procedure",
        "rollback_tested",
        "rollback_window_minutes"
      ],
      "properties": {
        "rollback_token_required": { "type": "boolean" },
        "rollback_token": { "type": "string" },
        "rollback_procedure": { "type": "string", "minLength": 1 },
        "rollback_tested": { "type": "boolean" },
        "rollback_window_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "drift_pack": {
      "type": "object",
      "required": ["last_drift_scan", "drift_active", "active_drift_items", "resolution_plan"],
      "properties": {
        "last_drift_scan": { "type": "string", "format": "date-time" },
        "drift_active": { "type": "boolean" },
        "active_drift_items": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resolution_plan": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "validation_result": {
      "type": "object",
      "required": ["validator", "schema_version", "result", "violations"],
      "properties": {
        "validator": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "result": {
          "type": "string",
          "enum": ["PASS", "WARN", "FAIL", "BLOCK"]
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "message", "severity"],
            "properties": {
              "field": { "type": "string" },
              "message": { "type": "string" },
              "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
              "code": { "type": "string" }
            }
          }
        }
      }
    },
    "next_phase_readiness": {
      "type": "object",
      "required": ["phase7_ready", "phase10_readiness_note", "handoff_notes"],
      "properties": {
        "phase7_ready": { "type": "boolean" },
        "phase10_readiness_note": { "type": "string" },
        "handoff_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "signoffEntry": {
      "type": "object",
      "required": ["name", "timestamp", "decision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "decision": {
          "type": "string",
          "enum": ["approved", "rejected", "pending", "not_required"]
        }
      }
    }
  },
  "additionalProperties": false
}
