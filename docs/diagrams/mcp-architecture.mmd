        WorkOS["WorkOS<br/>Enterprise SSO"]
    end

    subgraph Deployment["Deployment"]
        Vercel["Vercel<br/>Serverless"]
        Local["Local Dev<br/>CLI"]
    end

    Agents -->|MCP Protocol| Tools
    Tools --> Services
    Services --> Infrastructure
    Infrastructure --> External

    Search --> Supabase
    Search --> Vertex
    EmbeddingFactory --> Vertex
    EmbeddingFactory --> Upstash
    HybridAuth --> AuthKit
    HybridAuth --> WorkOS
    RateLimiter --> Upstash
    Permissions --> Supabase

    FastMCP --> Deployment

