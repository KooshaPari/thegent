flowchart TB
    subgraph Agents["AI Agents / Clients"]
        Claude["Claude<br/>Desktop/API"]
        Cursor["Cursor IDE"]
        CustomAgent["Custom MCP<br/>Agents"]
    end

    subgraph FastMCP["FastMCP Server (v2.13.1)"]
        subgraph Tools["5 Consolidated Tools"]
            Workspace["workspace_operation<br/>set/get/list/create/update/delete"]
            Entity["entity_operation<br/>CRUD on docs/requirements/tasks"]
            Relationship["relationship_operation<br/>create/query/delete relations"]
            Workflow["workflow_execute<br/>multi-step transactions"]
            Query["data_query<br/>FTS/semantic/hybrid/aggregation"]
        end

        subgraph Services["Services Layer"]
            Search["Unified Search<br/>FTS + Vector Hybrid"]
            EmbeddingFactory["Embedding Factory<br/>Vertex AI + Cache"]
            RelEngine["Relationship Engine<br/>Graph Operations"]
            Compliance["Compliance Engine<br/>Audit Logging"]
            Events["Event Publisher<br/>Real-time Updates"]
        end

        subgraph Infrastructure["Infrastructure Layer"]
            HybridAuth["Hybrid Auth Provider<br/>OAuth PKCE + Bearer"]
            Permissions["Permission Middleware<br/>RLS Enforcement"]
            RateLimiter["Distributed Rate Limiter<br/>Redis-backed"]
            Concurrency["Concurrency Manager<br/>Parallel Operations"]
            Health["Health & Monitoring<br/>Diagnostics"]
        end
    end

    subgraph External["External Services"]
        Supabase[("Supabase<br/>PostgreSQL + RLS")]
        Upstash[("Upstash Redis<br/>Cache + Rate Limit")]
        Vertex["Google Vertex AI<br/>Embeddings"]
