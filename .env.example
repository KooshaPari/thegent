# thegent Environment Configuration
# Use THGENT_ prefix for all project-specific settings

# --- Core Paths ---
THGENT_SESSION_DIR=.thegent/sessions
THGENT_FACTORY_SKILLS_DIR=~/.factory/skills
THGENT_FACTORY_DROIDS_DIR=~/.factory/droids

# --- Model Defaults ---
THGENT_DEFAULT_CURSOR_MODEL=gemini-3-flash
THGENT_DEFAULT_GEMINI_MODEL=gemini-2.0-flash
THGENT_DEFAULT_CLAUDE_MODEL=haiku
THGENT_DEFAULT_CODEX_MODEL=gpt-5.3-codex

# --- Timeouts & Routing ---
THGENT_DEFAULT_TIMEOUT=90
THGENT_DEFAULT_TIMEOUT_CLAUDE=300
THGENT_DEFAULT_ROUTING=prefer_direct

# --- MCP & Proxy ---
THGENT_MCP_HOST=127.0.0.1
THGENT_MCP_PORT=3847
THGENT_CLIPROXY_BINARY=cli-proxy-api-plus
THGENT_CLIPROXY_PORT=8317
THGENT_CLIPROXY_AUTH_DIR=~/.cli-proxy-api

# --- Governance ---
THGENT_ENVIRONMENT=development
THGENT_TRUST_SCORE_THRESHOLD=0.8
THGENT_NORMALIZATION_POLICY_ALLOW_FALLBACK=true
THGENT_NORMALIZATION_POLICY_MIN_CONFIDENCE=0.4
THGENT_COST_TRACKING_ENABLED=true
THGENT_COST_BUDGET_MTD=100.0

# --- Retention ---
THGENT_RETENTION_DAYS_SESSIONS=30
THGENT_RETENTION_DAYS_REGISTRY=90
THGENT_RETENTION_DAYS_HEALTH=90
