# thegent environment overrides
# Copy to .env and adjust as needed

# Cursor agent CLI (if cursor-agent not on PATH, use cursor or set path)
# THGENT_CURSOR_AGENT_CMD=/usr/local/bin/cursor-agent
# THGENT_CURSOR_AGENT_CMD=/path/to/cursor

# Session directory
# THGENT_SESSION_DIR=~/.cache/thegent/sessions

# MCP server
# THGENT_MCP_HOST=127.0.0.1
# THGENT_MCP_PORT=3847
