{
  "name": "thegent",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "pip install uv && (uv sync 2>/dev/null && uv run pip install -e . 2>/dev/null || pip install -e . 2>/dev/null || uv tool install thegent 2>/dev/null || pip install thegent 2>/dev/null) || true",
  "postStartCommand": "thegent --help >/dev/null 2>&1 || true",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.local/bin"
  },
  "forwardPorts": [3847],
  "portsAttributes": {
    "3847": {
      "label": "thegent MCP",
      "onAutoForward": "notify"
    }
  }
}
