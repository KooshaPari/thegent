# Performance optimization: Exclude large directories from Cursor searches
# This significantly speeds up glob/grep/find operations

# Rust build artifacts (1.5GB+)
crates/target/
**/target/
Cargo.lock

# Node modules (689MB)
node_modules/

# Python virtual environment (623MB)
.venv/
venv/
env/
__pycache__/

# Python caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.uv-cache/
.coverage
htmlcov/

# Large data directories
artifacts/
.process-compose/
.factory-seed/
mcp_backup/

# Build outputs
dist/
build/
*.egg-info/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
