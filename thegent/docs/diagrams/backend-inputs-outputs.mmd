    end

    subgraph Request["Request Schema"]
        Model["model: string<br/>claude-4.5-sonnet"]
        Messages["messages: array<br/>[{role, content}]"]
        Stream["stream: boolean<br/>true/false"]
        Temp["temperature: float<br/>0.0-2.0"]
        MaxTok["max_tokens: int<br/>1-4000"]
        SysPrompt["system_prompt?: string<br/>Override prompt"]
    end

    subgraph Processing["Processing"]
        Validate["Validate JWT"]
        Compose["Compose Prompt<br/>4-level hierarchy"]
        MCP["Load MCP Tools"]
        Call["Call Claude"]
    end

    subgraph Outputs["API Outputs"]
        Success["Success Response<br/>ChatCompletionResponse"]
        SSE["Streaming Response<br/>Server-Sent Events"]
        Error["Error Response<br/>{detail, status}"]
    end

    subgraph Response["Response Schema"]
        ID["id: string<br/>chatcmpl-xxx"]
        Choices["choices: array<br/>[{message, finish_reason}]"]
        Usage["usage: object<br/>{prompt_tokens, completion_tokens}"]
        Created["created: int<br/>Unix timestamp"]
    end

    Inputs --> Request
    Request --> Processing
    Processing --> Outputs
    Outputs --> Response

