%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#DC2626', 'primaryTextColor': '#fff', 'primaryBorderColor': '#B91C1C', 'lineColor': '#EF4444'}}}%%
flowchart LR
    subgraph Inputs["Tool Inputs"]
        Token["auth_token<br/>JWT Bearer"]
        Op["operation<br/>create/read/update/delete"]
        Type["entity_type<br/>document/requirement/project"]
        Data["data<br/>Entity properties"]
        Filters["filters<br/>Query conditions"]
    end

    subgraph Tools["5 Tools"]
        WS["workspace_operation<br/>set/get context"]
        ENT["entity_operation<br/>CRUD + search"]
        REL["relationship_operation<br/>link/unlink/list"]
        WF["workflow_execute<br/>multi-step"]
        QRY["data_query<br/>search/aggregate/rag"]
    end

    subgraph Processing["Processing"]
        Auth["Validate Token"]
        RLS["Apply RLS Context"]
        Inject["Auto-inject Context"]
        Execute["Execute Operation"]
    end

    subgraph Outputs["Tool Outputs"]
        Success["Success Response"]
        Error["Error Response"]
    end

    subgraph Response["Response Schema"]
        SuccessFlag["success: boolean"]
        DataField["data: object/array"]
        ErrorField["error?: string"]
        ErrorCode["error_code?: string"]
        Metadata["metadata: object<br/>{operation, duration_ms}"]
    end

    Inputs --> Tools
    Tools --> Processing
    Processing --> Outputs
    Outputs --> Response

    classDef input fill:#4F46E5,stroke:#3730A3,color:#fff
    classDef tools fill:#7C3AED,stroke:#6D28D9,color:#fff
    classDef process fill:#059669,stroke:#047857,color:#fff
    classDef output fill:#DC2626,stroke:#B91C1C,color:#fff
    classDef response fill:#F59E0B,stroke:#D97706,color:#fff

    class Token,Op,Type,Data,Filters input
    class WS,ENT,REL,WF,QRY tools
    class Auth,RLS,Inject,Execute process
    class Success,Error output
    class SuccessFlag,DataField,ErrorField,ErrorCode,Metadata response
