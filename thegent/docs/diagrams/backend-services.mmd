        Models["VertexModelService<br/>Model listing"]
        Embed["VertexEmbeddingService<br/>Embeddings"]
        OCR["VertexOcrService<br/>Document OCR"]
        Sandbox["SandboxManager<br/>Code execution"]
    end

    subgraph DataServices["Data Services"]
        Files["FileStorageService<br/>Upload/download"]
        Platform["PlatformService<br/>Admin ops"]
        Analytics["AnalyticsService<br/>Usage tracking"]
        Artifacts["ArtifactService<br/>Storage"]
    end

    subgraph AgentServices["Agent API Services"]
        Agents["AgentService<br/>Agent CRUD"]
