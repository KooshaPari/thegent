        Threads["ThreadService<br/>Threads"]
        Messages["MessageService<br/>Messages"]
        Runs["RunService<br/>Execution"]
        Batch["BatchJobService<br/>Batch processing"]
    end

    subgraph Support["Support Services"]
        Cache["CacheService<br/>Redis/Memory"]
        Observe["ObservabilityService<br/>Tracing"]
        Auth["PermissionCache<br/>4-5x faster checks"]
    end

