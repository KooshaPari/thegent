[importlinter]
root_packages =
    thegent

[importlinter:contract:hexagonal-layers]
name = Hexagonal architecture layer enforcement
type = layers
layers =
    thegent.infrastructure
    thegent.adapters
    thegent.application
    thegent.domain

[importlinter:contract:domain-independence]
name = Domain layer must not import from other layers
type = forbidden
source_modules =
    thegent.domain
forbidden_modules =
    thegent.application
    thegent.adapters
    thegent.infrastructure

[importlinter:contract:application-no-adapters]
name = Application layer must not import from adapters or infrastructure
type = forbidden
source_modules =
    thegent.application
forbidden_modules =
    thegent.adapters
    thegent.infrastructure
