{
  "$schema": "https://fast-check.dev/schema/configuration.json",
  "numRuns": 100,
  "maxSkipsPerRun": 100,
  "endOnFailure": false,
  "markInterruptAsFailure": true,
  "skipAllAfterTimeLimit": 60000,
  "interruptAfterTimeLimit": 120000,
  "verbose": 1,
  "seed": null,
  "reporter": "default",
  "examples": [],
  "errorWithCause": true,
  "profiles": {
    "ci": {
      "numRuns": 500,
      "skipAllAfterTimeLimit": 120000,
      "interruptAfterTimeLimit": 300000
    },
    "dev": {
      "numRuns": 25,
      "skipAllAfterTimeLimit": 10000,
      "interruptAfterTimeLimit": 30000,
      "verbose": 2
    }
  }
}
