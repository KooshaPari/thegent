{
  "_comment": "Toxiproxy — Network fault injection for resilience testing",
  "_install": "brew install toxiproxy OR go install github.com/Shopify/toxiproxy/v2/cmd/toxiproxy-server@latest",
  "_docs": "https://github.com/Shopify/toxiproxy",
  "proxies": {
    "database": {
      "listen": "localhost:15432",
      "upstream": "localhost:5432",
      "enabled": true
    },
    "redis": {
      "listen": "localhost:16379",
      "upstream": "localhost:6379",
      "enabled": true
    },
    "api_upstream": {
      "listen": "localhost:18080",
      "upstream": "localhost:8080",
      "enabled": true
    }
  },
  "toxic_presets": {
    "slow_network": {
      "type": "latency",
      "stream": "downstream",
      "attributes": {
        "latency": 1000,
        "jitter": 500
      }
    },
    "connection_timeout": {
      "type": "timeout",
      "stream": "downstream",
      "attributes": {
        "timeout": 5000
      }
    },
    "bandwidth_limit": {
      "type": "bandwidth",
      "stream": "downstream",
      "attributes": {
        "rate": 1024
      }
    },
    "connection_reset": {
      "type": "reset_peer",
      "stream": "downstream",
      "attributes": {
        "timeout": 2000
      }
    },
    "packet_loss": {
      "type": "slicer",
      "stream": "downstream",
      "attributes": {
        "average_size": 1,
        "size_variation": 1,
        "delay": 10
      }
    }
  }
}
