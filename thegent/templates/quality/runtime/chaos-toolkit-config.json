{
  "_comment": "Chaos Toolkit — Chaos engineering experiment template",
  "_install": "pip install chaostoolkit chaostoolkit-lib",
  "_docs": "https://chaostoolkit.org/",
  "title": "Service resilience under dependency failure",
  "description": "Verify system handles gracefully when {dependency} is unavailable",
  "tags": ["resilience", "chaos", "dependency-failure"],
  "steady-state-hypothesis": {
    "title": "Service responds within SLA",
    "probes": [
      {
        "type": "probe",
        "name": "health-endpoint-responds",
        "tolerance": {
          "type": "jsonpath",
          "path": "$.status",
          "expect": "ok"
        },
        "provider": {
          "type": "http",
          "url": "http://localhost:8080/health",
          "timeout": 5
        }
      },
      {
        "type": "probe",
        "name": "response-time-within-sla",
        "tolerance": {
          "type": "range",
          "range": [0, 2000]
        },
        "provider": {
          "type": "http",
          "url": "http://localhost:8080/api/ping",
          "timeout": 5
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "kill-dependency",
      "provider": {
        "type": "process",
        "path": "kill",
        "arguments": "-TERM $(pgrep -f {dependency})"
      },
      "pauses": {
        "after": 10
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "restart-dependency",
      "provider": {
        "type": "process",
        "path": "systemctl",
        "arguments": "restart {dependency}"
      }
    }
  ]
}
