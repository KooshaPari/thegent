-- Strict Luacheck configuration
-- All warnings enabled
std = "max"
max_line_length = 120
max_code_line_length = 120
max_string_line_length = false
max_comment_line_length = false

-- Enable all warnings
codes = true
ranges = true

-- No unused variables or arguments
unused = true
unused_args = true
unused_secondaries = true

-- Enforce no globals
allow_defined = false
allow_defined_top = false

-- Redefined variables
redefined = true

-- Module detection
modules = true
