# PHPStan Configuration for PHP
# Based: phpstan.org/user-guide/configuration + PHPStan docs

includes:
    - vendor/phpstan/phpstan-mysql-limits/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    # Level 9 is max strictness (recommended for projects)
    level: max

    # Paths to analyse
    paths:
        - src
        - tests

    # Exclude paths
    excludePaths:
        - 'vendor/*'
        - 'node_modules/*'
        - 'var/*'
        - 'runtime/*'

    # Ignore errors in specific files
    ignoreErrors:
        - '#^Cannot call method.*#'
        - '#^Call to an undefined method.*#'

    # Report analysis even when errors are found
    reportUnmatchedEnabledErrors: true

    # Treat PHP version
    phpVersion: 80300

    # Universal object crate classes
    universalObjectCratesClasses:
        - stdClass
        - SimpleXMLElement
        - DOMDocument

    # Tips for better type inference
    tipsOfTheDay:
        - 'https://phpstan.org/blog/tips-of-the-day'

    # Parallel processing
    parallel:
        processTimeout: 300.0

    # Memory limit
    memoryLimit: 512M

# Custom rules configuration
strictRules:
    # Enable strict type checking
    disallowMixedTypeHint: true
    checkThisOnly: true

deprecationRules:
    # Report dead code caused by deprecated methods
    reportDeprecatedCodeUsedInTests: true

# Bleeding edge (unstable features)
# Uncomment for maximum strictness:
#includes:
#    - vendor/phpstan/phpstan/bleeding.neon
