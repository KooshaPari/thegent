# {{project_name}} Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME={{project_name}}
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

{% if language == "python" -%}
# Database
DATABASE_URL=sqlite:///./{{project_name}}.db

# API Keys (optional)
# API_KEY=
# OPENAI_API_KEY=

{% elif language == "typescript" -%}
# API
API_URL=http://localhost:3000
API_PREFIX=/api

{% elif language == "go" -%}
# Server
HOST=localhost
PORT=8080

{% endif -%}

# Logging
LOG_LEVEL=debug
