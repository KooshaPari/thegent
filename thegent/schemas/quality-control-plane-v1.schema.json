{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thegent.dev/schemas/quality-control-plane-v1.schema.json",
  "title": "quality control plane policy v1",
  "type": "object",
  "required": [
    "version",
    "selected_plane",
    "policy_mode",
    "adapters",
    "required_artifacts",
    "gates"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "selected_plane": {
      "type": "string",
      "enum": ["github_sarif_native", "sonar_hybrid", "in_house"]
    },
    "policy_mode": {
      "type": "string",
      "enum": ["contract_first"]
    },
    "adapters": {
      "type": "object",
      "required": ["github_code_scanning", "sonar_bridge"],
      "properties": {
        "github_code_scanning": {
          "type": "object",
          "required": ["enabled", "sarif_required"],
          "properties": {
            "enabled": { "type": "boolean" },
            "sarif_required": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "sonar_bridge": {
          "type": "object",
          "required": ["enabled", "mode"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "type": "string", "enum": ["optional_downstream", "primary"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "gates": {
      "type": "object",
      "required": ["allow_missing_artifacts_in_pr", "require_contract_validation_in_nightly"],
      "properties": {
        "allow_missing_artifacts_in_pr": { "type": "boolean" },
        "require_contract_validation_in_nightly": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
