{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thegent.dev/schemas/task-output.schema.json",
  "title": "Task Output Schema",
  "description": "Schema for task execution results",
  "type": "object",
  "required": ["task_id", "status", "timestamp"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Task ID that was executed"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "cancelled", "in_progress"],
      "description": "Task execution status"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of status change"
    },
    "agent": {
      "type": "string",
      "description": "Agent that executed the task"
    },
    "session_id": {
      "type": "string",
      "description": "Session ID for the execution"
    },
    "run_id": {
      "type": "string",
      "description": "Run ID for the execution"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Execution duration in seconds"
    },
    "output": {
      "type": "string",
      "description": "Task output (markdown supported)",
      "maxLength": 100000
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["file", "directory", "url", "artifact"]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Delivered artifacts",
      "default": []
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["parse_error", "validation_error", "execution_error", "system_error"]
          },
          "field": {
            "type": "string"
          },
          "traceback": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Errors encountered during execution",
      "default": []
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Warnings during execution",
      "default": []
    },
    "metrics": {
      "type": "object",
      "properties": {
        "tokens_used": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "files_modified": {
          "type": "integer",
          "minimum": 0
        },
        "files_created": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "acceptance_criteria_met": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "description": "Whether each acceptance criterion was met",
      "default": []
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suggested next steps",
      "default": []
    }
  },
  "additionalProperties": false
}
