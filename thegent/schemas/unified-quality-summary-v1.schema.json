{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thegent.dev/schemas/unified-quality-summary-v1.schema.json",
  "title": "Unified Quality Summary v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "overall_status",
    "components"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "unified-quality-summary/v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "overall_status": {
      "type": "string",
      "enum": ["ok", "warn", "fail"]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "path", "exists"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["ok", "warn", "missing", "fail"] },
          "path": { "type": "string", "minLength": 1 },
          "exists": { "type": "boolean" },
          "details": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
