# ~/.zshrc.local — Your custom zsh plugins (thegent never overwrites this)
# Copy: cp thegent/shell/zshrc.local.template ~/.zshrc.local
# See: docs/guides/SHELL_ZSH_PLUGIN_SETUP.md

# -----------------------------------------------------------------------------
# 1. Node version manager: fnm (fast) or mise (polyglot)
# -----------------------------------------------------------------------------
# Option A: fnm (Node only)
# [[ -n "$(command -v fnm 2>/dev/null)" ]] && eval "$(fnm env --use-on-cd --shell zsh)"

# Option B: mise (Node, Python, Go, etc.)
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh 2>/dev/null)" || true
elif [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh 2>/dev/null)" || true
fi

# -----------------------------------------------------------------------------
# 2. Completions + fzf-tab (load in this order)
# -----------------------------------------------------------------------------
autoload -U compinit
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION"

# fzf-tab: replace default completion menu with fzf (requires fzf installed)
if [[ -f "${HOME}/.zsh/plugins/fzf-tab/fzf-tab.plugin.zsh" ]]; then
  source "${HOME}/.zsh/plugins/fzf-tab/fzf-tab.plugin.zsh"
fi

# -----------------------------------------------------------------------------
# 3. zsh-autosuggestions (optional)
# -----------------------------------------------------------------------------
if [[ -f "${HOME}/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "${HOME}/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# -----------------------------------------------------------------------------
# 4. fast-syntax-highlighting (optional, load last)
# -----------------------------------------------------------------------------
if [[ -f "${HOME}/.zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh" ]]; then
  source "${HOME}/.zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
fi

# -----------------------------------------------------------------------------
# 5. Prompt: starship or powerlevel10k
# -----------------------------------------------------------------------------
# Option A: starship (cross-shell)
# if command -v starship &>/dev/null; then
#   eval "$(starship init zsh)"
# fi

# Option B: powerlevel10k
if [[ -f "${HOME}/.zsh/themes/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  source "${HOME}/.zsh/themes/powerlevel10k/powerlevel10k.zsh-theme"
fi

# -----------------------------------------------------------------------------
# 6. Secrets (create ~/.zshrc.secrets manually, never commit)
# -----------------------------------------------------------------------------
[[ -f "${HOME}/.zshrc.secrets" ]] && source "${HOME}/.zshrc.secrets"

# -----------------------------------------------------------------------------
# 7. Optional: fd as find for simple cases (macOS find doesn't support -q)
# Use: alias find='fd_find_safe' or similar if you want fd for trivial find
# -----------------------------------------------------------------------------
