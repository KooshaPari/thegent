# TheGent Agent Zsh Profile (.zshrc.agent)
# ---------------------------------------------------------
# Optimized for high-performance agent automation.
# Minimal, zero-interactive-latency, structured logging.
# ---------------------------------------------------------

# 1. Performance: Skip all interactive-only features
export THEGENT_AGENT_MODE=1
export ZSH_AUTOSUGGEST_STRATEGY=none
export ZSH_HIGHLIGHT_MAXLENGTH=0
export COMPLETION_WAITING_DOTS="false"

# 2. Path Management: Ensure agent-specific bins are prioritized
export PATH="$HOME/.local/bin:$PATH"
if [ -d "./node_modules/.bin" ]; then
    export PATH="./node_modules/.bin:$PATH"
fi

# 3. Aliases: Common QOL mirroring host user's experience
alias g='git'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias pip='uv pip'
alias npm='bun'
alias npx='bunx'

# 4. thegent Hook (Agent Edition)
# Instead of full interactive hooks, we use a simple command timer
# for the BottleneckDetector in the parent system.
preexec() {
    export THEGENT_CMD_START_TIME=$(date +%s%N)
}

precmd() {
    if [ -n "$THEGENT_CMD_START_TIME" ]; then
        local end_time=$(date +%s%N)
        local duration=$(( ($end_time - $THEGENT_CMD_START_TIME) / 1000000 ))
        # Write to a structured trace log for the agent monitor
        echo "{\"event\": \"cmd_done\", \"cmd\": \"$1\", \"duration_ms\": $duration}" >> "$THEGENT_AGENT_LOG_DIR/execution.jsonl"
        unset THEGENT_CMD_START_TIME
    fi
}

# 5. Git Guardrail: Always tag commits by this specific agent
git() {
    if [[ "$1" == "commit" ]]; then
        command git "$@" --message "[thegent-agent: $THEGENT_AGENT_ID] $(date)"
    else
        command git "$@"
    fi
}

# 6. Silent Prompt: Minimum noise in logs
PROMPT='%n@%m %~ %# '

# 7. Environment Sync: Inherit from parent tenant context
# (Usually already handled by SubUserIsolationProvider, but here as a fallback)
if [ -f "$HOME/.thegent_env" ]; then
    source "$HOME/.thegent_env"
fi

# Final sign-off for the monitor
echo "Agent environment initialized."
