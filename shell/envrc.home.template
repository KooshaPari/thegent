# direnv integration - home and project directories
# Installed by: thegent install -t envrc (or thegent install -t all)
# Guards prevent use flake in home (no flake.nix), avoid FUNCNEST recursion
# See: docs/ZSH_HANG_DROID_FIX.md, thegent/docs/research/DIRENV_*.md

# Git identity policy (optional)
# export THGENT_GIT_DEFAULT_ACTOR_PROFILE="human"   # human|agent|codex|claude...
# export THGENT_GIT_IDENTITY_MAP='{"codex":{"name":"Claude Bot","email":"codex-bot@users.noreply.github.com"},"agent":"The Gent Agent"}'
# export THGENT_GIT_AUTHOR_NAME="Kooshapari"
# export THGENT_GIT_AUTHOR_EMAIL="koosha@example.com"

# Mark direnv context for fork guard / safeguards (skip heavy checks during load)
export DIRENV_IN_ENVRC=1

# Non-interactive: skip nix/venv to avoid hangs (direnv still exits 0)
if [ -z "${PS1:-}" ] && [ ! -t 0 ]; then
  unset DIRENV_IN_ENVRC
  exit 0
fi

# Nix flake: only when flake.nix exists in current directory
# CRITICAL: In home (~) there is no flake.nix - use flake would error and cause recursion
if command -v nix_direnv >/dev/null 2>&1 || command -v nix >/dev/null 2>&1; then
  if [ -f flake.nix ]; then
    # Preemptive cleanup: remove stale index.lock before use flake (avoids nix/direnv block)
    command -v thegent >/dev/null 2>&1 && thegent git lock-cleanup --path . 2>/dev/null || true
    use flake
  fi
# Fallback: Python venv when available
elif [ -d .venv ]; then
  source .venv/bin/activate
  export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$(pwd)/src"
  export PATH="$(pwd)/.venv/bin:${HOME}/.local/bin:${PATH}"
fi

# Clear marker so fork guard runs normally in interactive shells
unset DIRENV_IN_ENVRC
