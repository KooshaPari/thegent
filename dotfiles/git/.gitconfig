# dotfiles/git/.gitconfig
# Canonical git configuration for Phenotype development
# Install: ln -sf "$DOTFILES_DIR/git/.gitconfig" ~/.gitconfig
#
# NOTE: Set user.name and user.email in ~/.gitconfig.local (not committed)

[include]
  path = ~/.gitconfig.local

[core]
  editor = nvim
  pager = delta
  autocrlf = input
  excludesfile = ~/.gitignore_global
  # Speed up status on large repos
  untrackedCache = true
  fsmonitor = true

[init]
  defaultBranch = main

[pull]
  rebase = false

[push]
  default = current
  autoSetupRemote = true

[fetch]
  prune = true
  prunetags = true

[rebase]
  autosquash = true
  autostash = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default
  algorithm = histogram

[delta]
  navigate = true
  light = false
  side-by-side = true
  line-numbers = true

[interactive]
  diffFilter = delta --color-only

[alias]
  # Status
  st = status --short --branch
  # Log
  log1 = log --oneline --graph --decorate -20
  hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
  # Branches
  br = branch -vv
  bra = branch -avv
  # Stash
  sp = stash pop
  ss = stash push -m
  sl = stash list
  # Undo
  undo = reset --soft HEAD~1
  # Cleanup
  cleanup = !git branch --merged | grep -v '\\*\\|main\\|master' | xargs -n 1 git branch -d
  # Worktrees
  wt = worktree
  wta = worktree add
  wtl = worktree list
  wtr = worktree remove
  # Misc
  aliases = !git config --get-regexp 'alias.*' | sed 's/alias\\.//g'
  root = rev-parse --show-toplevel

[credential]
  helper = osxkeychain

[url "git@github.com:"]
  insteadOf = gh:

[color]
  ui = auto

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
