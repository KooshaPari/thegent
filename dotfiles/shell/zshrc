# Deferred heavy plugins — load after first prompt renders (invisible to user)
_load_plugins_deferred() {
    add-zsh-hook -d precmd _load_plugins_deferred
    # fzf-tab: tab-completion with fzf
    [[ -f "${HOME}/.zsh/plugins/fzf-tab/fzf-tab.plugin.zsh" ]] && \
        source "${HOME}/.zsh/plugins/fzf-tab/fzf-tab.plugin.zsh"
    # syntax-highlighting: MUST be last plugin loaded
    if [[ -f "${HOME}/.zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh" ]]; then
        source "${HOME}/.zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
    elif [[ -f "${HOME}/.oh-my-zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
        source "${HOME}/.oh-my-zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
    fi
}
add-zsh-hook precmd _load_plugins_deferred
