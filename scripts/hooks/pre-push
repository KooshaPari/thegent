#!/usr/bin/env bash
# =============================================================================
# Phenotype Ecosystem — Local Pre-Push Quality Gate
# =============================================================================
# This script replaces billed GitHub Actions macOS/Windows CI gates.
# All merge gates are LOCAL; GitHub Actions is validation/telemetry only.
#
# Usage:
#   Install: ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push
#   Run:     ./scripts/hooks/pre-push
#   Skip:    SKIP_LOCAL_PREPUSH=1 git push
#
# What it checks:
#   - Rust: cargo check --all-targets
#   - TypeScript/JS: bun tsc --noEmit (or npm/node equivalents)
#   - Python: python -m py_compile on staged files
#   - Go: go build ./...
#   - Shell: shellcheck on staged .sh files
# =============================================================================

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Defaults
SKIP_FILETYPES="${SKIP_FILETYPES:-}"
VERBOSE="${VERBOSE:-0}"

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
info()    { echo -e "${GREEN}[INFO]${NC} $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }
verbose() { [[ "$VERBOSE" == "1" ]] && echo -e "[DEBUG] $*"; }

# Check if file matches skip patterns
should_skip() {
    local file="$1"
    for pattern in $SKIP_FILETYPES; do
        [[ "$file" == $pattern ]] && return 0
    done
    return 1
}

# Detect project type from lockfiles
detect_project_type() {
    if [[ -f "Cargo.toml" ]]; then echo "rust"
    elif [[ -f "package.json" ]]; then echo "node"
    elif [[ -f "pyproject.toml" || -f "requirements.txt" ]]; then echo "python"
    elif [[ -f "go.mod" ]]; then echo "go"
    elif [[ -f "*.cabal" || -f "stack.yaml" ]]; then echo "haskell"
    else echo "unknown"
    fi
}

# -----------------------------------------------------------------------------
# Language-specific checks
# -----------------------------------------------------------------------------
check_rust() {
    info "Checking Rust project..."
    if command -v cargo &>/dev/null; then
        cargo check --all-targets --quiet 2>&1 | while read -r line; do
            error "$line"
        done
        info "Rust check passed"
    else
        warn "cargo not found, skipping Rust checks"
    fi
}

check_node() {
    info "Checking Node/TypeScript project..."
    if [[ -f "tsconfig.json" ]]; then
        if command -v bun &>/dev/null; then
            bun tsc --noEmit --project tsconfig.json 2>&1 | while read -r line; do
                error "$line"
            done
        elif command -v npx &>/dev/null; then
            npx tsc --noEmit --project tsconfig.json 2>&1 | while read -r line; do
                error "$line"
            done
        fi
        info "TypeScript check passed"
    else
        info "No tsconfig.json, skipping Node checks"
    fi
}

check_python() {
    info "Checking Python project..."
    if command -v python3 &>/dev/null; then
        python3 -m py_compile 2>&1 | while read -r line; do
            error "$line"
        done
        info "Python check passed"
    else
        warn "python3 not found, skipping Python checks"
    fi
}

check_go() {
    info "Checking Go project..."
    if command -v go &>/dev/null; then
        go build ./... 2>&1 | while read -r line; do
            error "$line"
        done
        info "Go check passed"
    else
        warn "go not found, skipping Go checks"
    fi
}

check_shell() {
    info "Checking shell scripts..."
    local_shell_files=()
    while IFS= read -r -d '' f; do
        if should_skip "$f"; then continue; fi
        [[ "$f" == *.sh ]] || continue
        shell_files+=("$f")
    done < <(git diff --cached --name-only --diff-filter=ACM -z 2>/dev/null || true)

    if [[ ${#shell_files[@]} -gt 0 ]] && command -v shellcheck &>/dev/null; then
        for f in "${shell_files[@]}"; do
            verbose "Shellchecking $f"
            shellcheck --severity=error "$f" 2>&1 | while read -r line; do
                error "$line"
            done
        done
        info "Shellcheck passed"
    fi
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------
main() {
    info "Phenotype Local Pre-Push Quality Gate"
    info "====================================="
    info "Billing-aware: GitHub Actions macOS/Windows CI is NOT the merge gate."
    info "Local checks are the source of truth."
    echo

    # Check for skip flag
    if [[ "${SKIP_LOCAL_PREPUSH:-}" == "1" ]]; then
        warn "SKIP_LOCAL_PREPUSH=1 set, skipping all checks"
        exit 0
    fi

    local project_type
    project_type=$(detect_project_type)
    info "Detected project type: $project_type"

    local exit_code=0

    case "$project_type" in
        rust)   check_rust   || exit_code=$? ;;
        node)   check_node   || exit_code=$? ;;
        python) check_python || exit_code=$? ;;
        go)     check_go    || exit_code=$? ;;
        *)
            warn "Unknown project type, running generic checks"
            ;;
    esac

    # Always run shell checks for shell scripts
    check_shell || exit_code=$?

    echo
    if [[ $exit_code -eq 0 ]]; then
        info "All local checks passed ✅"
        info "GitHub Actions is validation only (billing-aware)"
    else
        error "Local checks failed. Fix errors before pushing."
        error "If GitHub Actions is blocking, use SKIP_LOCAL_PREPUSH=1 to bypass locally."
    fi

    exit $exit_code
}

main "$@"
