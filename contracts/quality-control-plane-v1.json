{
  "version": "1.0.0",
  "selected_plane": "github_sarif_native",
  "policy_mode": "contract_first",
  "adapters": {
    "github_code_scanning": {
      "enabled": true,
      "sarif_required": true
    },
    "sonar_bridge": {
      "enabled": false,
      "mode": "optional_downstream"
    }
  },
  "required_artifacts": [
    "artifacts/hooks/quality-gate-result.json",
    "artifacts/hooks/security-pipeline-result.json",
    "artifacts/hooks/hooks-results.sarif",
    "artifacts/quality/generated-python-antipatterns.json",
    "artifacts/quality/generated-python-antipatterns.sarif",
    "artifacts/quality/mutation-perf-pilot.json"
  ],
  "gates": {
    "allow_missing_artifacts_in_pr": true,
    "require_contract_validation_in_nightly": true
  }
}
