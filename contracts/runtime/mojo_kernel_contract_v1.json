{
  "contract_id": "runtime.mojo_kernel.v1",
  "version": "1.0.0",
  "owner": "runtime-platform",
  "status": "draft",
  "kernel_catalog": [
    {
      "kernel_id": "score.rank.v1",
      "purpose": "deterministic route scoring and ranking",
      "input_schema_ref": "contracts/runtime/mojo_kernel_contract_v1.json#/schemas/score_rank_input",
      "output_schema_ref": "contracts/runtime/mojo_kernel_contract_v1.json#/schemas/score_rank_output",
      "deterministic": true
    }
  ],
  "execution_contract": {
    "transport": "subprocess-json-stdio",
    "entrypoint_cmd_template": "mojo run <kernel_file> --input-json <path>",
    "timeout_ms": 3000,
    "max_input_bytes": 1048576,
    "max_output_bytes": 1048576
  },
  "schemas": {
    "score_rank_input": {
      "type": "object",
      "required": [
        "request_id",
        "candidates",
        "weights"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "cost",
              "latency",
              "quality"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "cost": {
                "type": "number"
              },
              "latency": {
                "type": "number"
              },
              "quality": {
                "type": "number"
              }
            }
          }
        },
        "weights": {
          "type": "object",
          "required": [
            "cost",
            "latency",
            "quality"
          ],
          "properties": {
            "cost": {
              "type": "number"
            },
            "latency": {
              "type": "number"
            },
            "quality": {
              "type": "number"
            }
          }
        }
      }
    },
    "score_rank_output": {
      "type": "object",
      "required": [
        "request_id",
        "ranked"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "ranked": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "score",
              "rank"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "rank": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "correctness_contract": {
    "required_tests": [
      "schema_conformance",
      "deterministic_replay",
      "numeric_stability",
      "python_baseline_parity"
    ],
    "parity_tolerance": {
      "absolute_error_max": 1e-9,
      "rank_order_exact": true
    }
  },
  "benchmark_contract": {
    "harness_id": "mojo-kernel-bench-v1",
    "harness_definition_ref": "benchmarks/mojo_score_rank_v1_harness.json",
    "fixture_spec_ref": "benchmarks/mojo_score_rank_v1_fixture_spec.json",
    "datasets": [
      "small-128",
      "medium-1024",
      "large-8192"
    ],
    "correctness_hooks": [
      "fixture_expected_output_parity",
      "rank_order_exact",
      "score_absolute_error_max"
    ],
    "metrics": [
      "p50_ms",
      "p95_ms",
      "p99_ms",
      "throughput_ops_sec",
      "peak_rss_mb"
    ],
    "promotion_gate": {
      "p95_speedup_vs_python_min": 1.5,
      "p99_regression_max_pct": 5,
      "correctness_failures_allowed": 0
    }
  }
}
