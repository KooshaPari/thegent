{
  "contract_id": "runtime.zig_abi.v1",
  "version": "1.0.0",
  "owner": "runtime-platform",
  "status": "draft",
  "abi": {
    "calling_convention": "C",
    "target": [
      "native-dylib",
      "wasm32-wasi"
    ],
    "symbols": [
      {
        "name": "tg_zig_kernel_version",
        "kind": "function",
        "signature": "const char* tg_zig_kernel_version(void)",
        "stability": "required"
      },
      {
        "name": "tg_zig_init",
        "kind": "function",
        "signature": "int32_t tg_zig_init(const char* config_json, char** err_json_out)",
        "stability": "required"
      },
      {
        "name": "tg_zig_execute",
        "kind": "function",
        "signature": "int32_t tg_zig_execute(const char* request_json, char** response_json_out, char** err_json_out)",
        "stability": "required"
      },
      {
        "name": "tg_zig_free",
        "kind": "function",
        "signature": "void tg_zig_free(char* ptr)",
        "stability": "required"
      }
    ]
  },
  "wire_protocol": {
    "request_encoding": "utf-8-json",
    "response_encoding": "utf-8-json",
    "max_request_bytes": 1048576,
    "max_response_bytes": 1048576
  },
  "error_contract": {
    "error_envelope": {
      "required_fields": [
        "code",
        "message",
        "stage"
      ],
      "optional_fields": [
        "details",
        "retryable",
        "hint"
      ]
    },
    "codes": [
      "ZIG_INIT_FAILED",
      "ZIG_BAD_REQUEST",
      "ZIG_EXEC_FAILED",
      "ZIG_OOM",
      "ZIG_UNSUPPORTED_VERSION"
    ]
  },
  "compatibility": {
    "semantic_versioning": true,
    "breaking_change_rules": [
      "removing required symbol is breaking",
      "changing required signature is breaking",
      "changing required JSON field type is breaking"
    ],
    "deprecation_policy": {
      "minimum_minor_cycles": 2
    }
  },
  "validation": {
    "required_tests": [
      "abi_symbol_presence",
      "ffi_roundtrip_smoke",
      "error_envelope_conformance",
      "memory_free_safety",
      "wasm_target_build"
    ],
    "tooling": {
      "contract_validator": "scripts/validate_zig_abi_contract.py",
      "artifact_checker": "scripts/check_zig_abi_artifact.py"
    },
    "performance_slos": {
      "p50_ms": 5,
      "p95_ms": 20
    }
  }
}
