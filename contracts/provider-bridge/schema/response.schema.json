{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kush/contracts/provider-bridge/response.schema.json",
  "title": "ExecutionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bridge_schema_version",
    "request_id",
    "run_id",
    "status",
    "selected_route",
    "attempts",
    "usage",
    "output",
    "governance_outcome"
  ],
  "properties": {
    "bridge_schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "request_id": { "type": "string" },
    "run_id": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "error"] },
    "selected_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "subprovider_id", "model"],
      "properties": {
        "provider_id": { "type": "string" },
        "subprovider_id": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "attempts": { "type": "integer", "minimum": 1 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "estimated_cost_usd"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "tool_calls"],
      "properties": {
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "content"],
          "properties": {
            "role": { "type": "string", "enum": ["assistant"] },
            "content": { "type": "string" }
          }
        },
        "tool_calls": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "class"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "class": {
          "type": "string",
          "enum": [
            "transient_network",
            "provider_throttle",
            "provider_5xx",
            "policy_denied",
            "invalid_request",
            "tool_runtime_failure"
          ]
        }
      }
    },
    "governance_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_check", "rate_limit_check", "fallback_used"],
      "properties": {
        "budget_check": { "type": "string", "enum": ["pass", "fail"] },
        "rate_limit_check": { "type": "string", "enum": ["pass", "fail"] },
        "fallback_used": { "type": "boolean" },
        "fallback_depth": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "error" } }
      },
      "then": {
        "required": ["error"]
      }
    }
  ]
}

